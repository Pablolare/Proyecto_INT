<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true" stylesheets="@../styles.css" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javafx.ProyectoINT.Categorias.ControlCategorias">
   <content>
      <VBox spacing="15.0" style="-fx-padding: 25;">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <Button styleClass="button-secondary" mnemonicParsing="false" onAction="#PagAtras" text="&lt;">
                  <tooltip><Tooltip text="Volver a entrenos" /></tooltip>
               </Button>
               <Label styleClass="header-label" text="Categorías" />
               <Region HBox.hgrow="ALWAYS" />
               <Button styleClass="button-danger" mnemonicParsing="false" onAction="#Borrar" text="Borrar">
                  <tooltip><Tooltip text="Borrar la categoría seleccionada" /></tooltip>
               </Button>
            </HBox>

            <HBox spacing="20.0" VBox.vgrow="ALWAYS">
               <children>
                  <!-- Formulario -->
                  <VBox alignment="TOP_CENTER" spacing="15.0" prefWidth="300.0">
                     <children>
                        <VBox spacing="8.0" prefWidth="280.0">
                           <Label styleClass="label-bold" text="Nombre:" />
                           <TextField fx:id="txNombre">
                              <tooltip><Tooltip text="Nombre de la categoría" /></tooltip>
                           </TextField>
                        </VBox>

                        <VBox spacing="8.0" prefWidth="280.0">
                           <Label styleClass="label-bold" text="Descripción:" />
                           <TextField fx:id="txDescripcion">
                              <tooltip><Tooltip text="Descripción de la categoría" /></tooltip>
                           </TextField>
                        </VBox>

                        <HBox spacing="10.0" alignment="CENTER">
                           <Button mnemonicParsing="false" onAction="#Crear" text="Crear" minWidth="120.0" style="-fx-padding: 12 28;">
                              <tooltip><Tooltip text="Crear nueva categoría" /></tooltip>
                           </Button>
                           <Button styleClass="button-secondary" mnemonicParsing="false" onAction="#Actualizar" text="Actualizar" minWidth="120.0" style="-fx-padding: 12 28;">
                              <tooltip><Tooltip text="Guardar cambios de la categoría seleccionada" /></tooltip>
                           </Button>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- Tabla -->
                  <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                     <children>
                        <TextField fx:id="txtBuscar" promptText="Buscar categoría..." />
                        <Label styleClass="label-bold" text="Categorías existentes:" />
                        <TableView fx:id="tablaCategorias" VBox.vgrow="ALWAYS" minHeight="250.0">
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                           <columns>
                              <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                              <TableColumn fx:id="colNombre" prefWidth="150.0" text="Nombre" />
                              <TableColumn fx:id="colDescripcion" prefWidth="250.0" text="Descripción" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </content>
</ScrollPane>
