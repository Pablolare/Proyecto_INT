<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true" stylesheets="@../styles.css" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javafx.ProyectoINT.Objetivos.ControlObjetivos">
   <content>
      <VBox spacing="15.0" style="-fx-padding: 25;">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <Button styleClass="button-secondary" mnemonicParsing="false" onAction="#PagAtras" text="&lt;">
                  <tooltip><Tooltip text="Volver a la página principal" /></tooltip>
               </Button>
               <Label styleClass="header-label" text="Objetivos" />
               <Region HBox.hgrow="ALWAYS" />
               <Button styleClass="button-danger" mnemonicParsing="false" onAction="#Borrar" text="Borrar">
                  <tooltip><Tooltip text="Borrar el objetivo seleccionado" /></tooltip>
               </Button>
            </HBox>

            <HBox spacing="20.0" VBox.vgrow="ALWAYS">
               <children>
                  <!-- Formulario -->
                  <VBox alignment="TOP_CENTER" spacing="15.0" prefWidth="300.0">
                     <children>
                        <VBox spacing="8.0" prefWidth="280.0">
                           <Label styleClass="label-bold" text="Descripción:" />
                           <TextField fx:id="txDescripcion">
                              <tooltip><Tooltip text="Descripción del objetivo" /></tooltip>
                           </TextField>
                        </VBox>

                        <VBox spacing="8.0" prefWidth="280.0">
                           <Label styleClass="label-bold" text="Meta de aciertos (opcional):" />
                           <TextField fx:id="txMetaAciertos" promptText="Ej: 50">
                              <tooltip><Tooltip text="Número de aciertos a alcanzar (dejar vacío si no aplica)" /></tooltip>
                           </TextField>
                        </VBox>

                        <VBox spacing="8.0" prefWidth="280.0">
                           <Label styleClass="label-bold" text="Meta de repeticiones (opcional):" />
                           <TextField fx:id="txMetaRepeticiones" promptText="Ej: 100">
                              <tooltip><Tooltip text="Número de repeticiones a alcanzar (dejar vacío si no aplica)" /></tooltip>
                           </TextField>
                        </VBox>

                        <CheckBox fx:id="chkCumplido" text="Cumplido">
                           <tooltip><Tooltip text="Marcar si el objetivo ya ha sido cumplido" /></tooltip>
                        </CheckBox>

                        <HBox spacing="10.0" alignment="CENTER">
                           <Button mnemonicParsing="false" onAction="#Crear" text="Crear" minWidth="120.0" style="-fx-padding: 12 28;">
                              <tooltip><Tooltip text="Crear nuevo objetivo" /></tooltip>
                           </Button>
                           <Button styleClass="button-secondary" mnemonicParsing="false" onAction="#Actualizar" text="Actualizar" minWidth="120.0" style="-fx-padding: 12 28;">
                              <tooltip><Tooltip text="Guardar cambios del objetivo seleccionado" /></tooltip>
                           </Button>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- Tabla -->
                  <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                     <children>
                        <TextField fx:id="txtBuscar" promptText="Buscar objetivo..." />
                        <Label styleClass="label-bold" text="Objetivos:" />
                        <TableView fx:id="tablaObjetivos" VBox.vgrow="ALWAYS" minHeight="250.0">
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                           <columns>
                              <TableColumn fx:id="colId" prefWidth="40.0" text="ID" />
                              <TableColumn fx:id="colDescripcion" prefWidth="200.0" text="Descripción" />
                              <TableColumn fx:id="colMetaAciertos" prefWidth="90.0" text="Meta Aciert." />
                              <TableColumn fx:id="colMetaRepeticiones" prefWidth="90.0" text="Meta Repet." />
                              <TableColumn fx:id="colCumplido" prefWidth="80.0" text="Cumplido" />
                              <TableColumn fx:id="colFecha" prefWidth="150.0" text="Fecha" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </content>
</ScrollPane>
