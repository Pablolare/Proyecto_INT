<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" fitToHeight="true" stylesheets="@../styles.css" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javafx.ProyectoINT.ListarEjercicios.ControlListarEjercicios">
   <content>
      <VBox spacing="15.0" style="-fx-padding: 25;" minHeight="400.0">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
          <Button styleClass="button-secondary" mnemonicParsing="false" onAction="#PagAtras" text="&lt;">
             <tooltip><Tooltip text="Volver a la lista de entrenos" /></tooltip>
          </Button>
          <Label styleClass="header-label" text="Listar Ejercicios" />
          <Region HBox.hgrow="ALWAYS" />
          <Button styleClass="button-danger" mnemonicParsing="false" onAction="#Borrar" text="Borrar">
             <tooltip><Tooltip text="Borrar el ejercicio seleccionado" /></tooltip>
          </Button>
          <Button mnemonicParsing="false" onAction="#Editar" text="Editar">
             <tooltip><Tooltip text="Editar el ejercicio seleccionado" /></tooltip>
          </Button>
      </HBox>

      <TableView fx:id="tablaEjercicios" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
           <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
          <TableColumn fx:id="colId" prefWidth="75.0" text="ID" />
          <TableColumn fx:id="colNombre" prefWidth="220.0" text="Nombre Ejercicio" />
          <TableColumn fx:id="colTipo" prefWidth="150.0" text="Tipo" />
          <TableColumn fx:id="colFinalidad" prefWidth="155.0" text="Finalidad" />
        </columns>
      </TableView>

   </children>
</VBox>
   </content>
</ScrollPane>
