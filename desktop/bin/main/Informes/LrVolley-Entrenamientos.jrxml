	<query language="SQL"><![CDATA[SELECT 
    e.id_entreno,
    e.nombre_entreno,
    e.repeticiones,
    e.aciertos,
    e.fallos,
    CONCAT(u.nombre, ' ', u.apellido) AS usuario,
    ej.nombre_ejer AS ejercicio
FROM Entrenamientos e
INNER JOIN Usuario u ON e.id_usuario = u.id_usuario
INNER JOIN Ejercicio ej ON e.id_ejer = ej.id_ejer
ORDER BY e.id_entreno]]></query>
