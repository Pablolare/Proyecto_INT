<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<ScrollPane fitToWidth="true" fitToHeight="true" stylesheets="@../styles.css" style="-fx-background: #0f172a; -fx-background-color: #0f172a;" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javafx.ProyectoINT.Historial.ControlHistorial">
   <content>
      <VBox spacing="25.0" style="-fx-padding: 25; -fx-background-color: #0f172a;" prefWidth="780.0" minHeight="900.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#PagAtras" text="Atras">
                     <tooltip><javafx.scene.control.Tooltip text="Volver a la pagina principal" /></tooltip>
                  </Button>
                  <Label text="Historial y Progresion" style="-fx-font-size: 24px; -fx-text-fill: white; -fx-font-weight: bold;" />
               </children>
            </HBox>
            
            <HBox alignment="CENTER" spacing="30.0" style="-fx-padding: 20; -fx-background-color: rgba(30, 41, 59, 0.5); -fx-background-radius: 12px;">
               <children>
                  <VBox alignment="CENTER" spacing="5.0" style="-fx-padding: 20; -fx-background-color: rgba(255, 255, 255, 0.05); -fx-background-radius: 10px;">
                     <Label text="Total Entrenamientos" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;" />
                     <Label fx:id="lblTotalEntrenos" text="0" style="-fx-font-size: 32px; -fx-text-fill: #6366f1; -fx-font-weight: bold;" />
                  </VBox>
                  <VBox alignment="CENTER" spacing="5.0" style="-fx-padding: 20; -fx-background-color: rgba(255, 255, 255, 0.05); -fx-background-radius: 10px;">
                     <Label text="Total Aciertos" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;" />
                     <Label fx:id="lblTotalAciertos" text="0" style="-fx-font-size: 32px; -fx-text-fill: #4CAF50; -fx-font-weight: bold;" />
                  </VBox>
                  <VBox alignment="CENTER" spacing="5.0" style="-fx-padding: 20; -fx-background-color: rgba(255, 255, 255, 0.05); -fx-background-radius: 10px;">
                     <Label text="Total Fallos" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;" />
                     <Label fx:id="lblTotalFallos" text="0" style="-fx-font-size: 32px; -fx-text-fill: #f44336; -fx-font-weight: bold;" />
                  </VBox>
                  <VBox alignment="CENTER" spacing="5.0" style="-fx-padding: 20; -fx-background-color: rgba(255, 255, 255, 0.05); -fx-background-radius: 10px;">
                     <Label text="Porcentaje Aciertos" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;" />
                     <Label fx:id="lblPorcentaje" text="0%" style="-fx-font-size: 32px; -fx-text-fill: #6366f1; -fx-font-weight: bold;" />
                  </VBox>
               </children>
            </HBox>
            
            <VBox spacing="10.0">
               <children>
                  <Label text="Historial Detallado" style="-fx-font-size: 18px; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 0 15 0;" />
                  <TextField fx:id="txtBuscar" promptText="Buscar entrenamiento..." style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-prompt-text-fill: #64748b; -fx-border-color: #334155; -fx-border-radius: 6; -fx-background-radius: 6;" />
                  <TableView fx:id="tablaHistorial" minHeight="250.0" prefHeight="300.0" style="-fx-background-color: #1e293b; -fx-text-fill: white;">
                    <columnResizePolicy>
                       <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                      <TableColumn fx:id="colId" prefWidth="60.0" text="ID" style="-fx-alignment: CENTER;" />
                      <TableColumn fx:id="colIdUsuario" prefWidth="80.0" text="Usuario" style="-fx-alignment: CENTER;" />
                      <TableColumn fx:id="colNombre" prefWidth="280.0" text="Nombre Entreno" style="-fx-alignment: CENTER_LEFT;" />
                      <TableColumn fx:id="colAciertos" prefWidth="100.0" text="Aciertos" style="-fx-alignment: CENTER;" />
                      <TableColumn fx:id="colFallos" prefWidth="80.0" text="Fallos" style="-fx-alignment: CENTER;" />
                      <TableColumn fx:id="colCompletado" prefWidth="100.0" text="Completado" style="-fx-alignment: CENTER;" />
                    </columns>
                  </TableView>
               </children>
            </VBox>
            
            <VBox spacing="10.0">
               <children>
                  <Label text="Evolucion de Rendimiento" style="-fx-font-size: 18px; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 0 15 0;" />
                  <LineChart fx:id="lineChart" prefHeight="350.0" legendVisible="true" animated="true">
                     <xAxis>
                        <CategoryAxis fx:id="xAxis" label="Entrenamiento" side="BOTTOM" />
                     </xAxis>
                     <yAxis>
                        <NumberAxis fx:id="yAxis" label="Cantidad" side="LEFT" autoRanging="true" />
                     </yAxis>
                  </LineChart>
                  <HBox alignment="CENTER" spacing="10.0">
                     <children>
                        <Button text="Actualizar Grafico" onAction="#actualizarGrafico" minWidth="140.0">
                           <tooltip><javafx.scene.control.Tooltip text="Recargar los datos del grafico" /></tooltip>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </content>
</ScrollPane>