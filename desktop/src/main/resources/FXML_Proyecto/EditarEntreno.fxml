<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true" stylesheets="@../styles.css" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javafx.ProyectoINT.EditarEntreno.ControlEditarEntreno">
   <content>
      <HBox spacing="25.0" style="-fx-padding: 25;" minHeight="500.0">
         <children>
            <VBox prefWidth="300.0" spacing="12.0" styleClass="form-container">
               <children>
                  <Label styleClass="header-label" text="Editar Entreno" />

                  <VBox spacing="8.0">
                     <Label styleClass="label-bold" text="Nombre:" />
                     <TextField fx:id="txtNombre">
                        <tooltip><Tooltip text="Nombre del entrenamiento" /></tooltip>
                     </TextField>
                  </VBox>

                  <VBox spacing="8.0">
                     <Label styleClass="label-bold" text="Descripción:" />
                     <TextArea fx:id="txtDescripcion" promptText="Describe el objetivo del entrenamiento..." prefRowCount="4" wrapText="true">
                        <tooltip><Tooltip text="Descripción del entrenamiento (opcional)" /></tooltip>
                     </TextArea>
                  </VBox>

                  <VBox spacing="10.0" style="-fx-padding: 8 0 0 0;">
                     <Button mnemonicParsing="false" onAction="#Actualizar" text="Guardar Cambios" maxWidth="Infinity">
                        <tooltip><Tooltip text="Guardar nombre, descripción y límite del entrenamiento" /></tooltip>
                     </Button>
                     <Button mnemonicParsing="false" onAction="#EditarEjercicios" text="Editar Ejercicios" styleClass="button-secondary" maxWidth="Infinity">
                        <tooltip><Tooltip text="Editar los ejercicios disponibles en el catálogo" /></tooltip>
                     </Button>
                     <Button mnemonicParsing="false" onAction="#Aceptar" text="Cerrar / Volver" styleClass="button-secondary" maxWidth="Infinity">
                        <tooltip><Tooltip text="Volver a la lista de entrenos" /></tooltip>
                     </Button>
                  </VBox>
               </children>
            </VBox>

            <VBox styleClass="card" spacing="10.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="sub-header" text="Ejercicios en este entreno" />
                  <TableView fx:id="tablaEjercicios" VBox.vgrow="ALWAYS">
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <columns>
                        <TableColumn fx:id="colNombreEjer" prefWidth="160.0" text="Nombre" />
                        <TableColumn fx:id="colTipo" prefWidth="100.0" text="Tipo" />
                        <TableColumn fx:id="colFinalidad" prefWidth="120.0" text="Finalidad" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
         </children>
      </HBox>
   </content>
</ScrollPane>
