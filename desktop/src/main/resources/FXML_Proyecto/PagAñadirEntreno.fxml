<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true" stylesheets="@../styles.css" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javafx.ProyectoINT.PagAñadirEntreno.ControlPagAñadirEntreno">
   <content>
      <VBox spacing="15.0" style="-fx-padding: 25;" minHeight="500.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Button styleClass="button-secondary" mnemonicParsing="false" onAction="#PagAtras" text="&lt;">
                     <tooltip><Tooltip text="Volver a la pagina principal" /></tooltip>
                  </Button>
                  <Label styleClass="header-label" text="Nuevo Entreno" />
               </children>
            </HBox>

            <VBox spacing="8.0">
                <Label text="Nombre del Entrenamiento" styleClass="label-bold"/>
                <TextField fx:id="txtNuevoEntreno" promptText="Escribe el nombre del entrenamiento...">
                   <tooltip><Tooltip text="Nombre identificativo para el nuevo entrenamiento" /></tooltip>
                </TextField>
            </VBox>

            <VBox spacing="8.0">
               <Label text="Descripción" styleClass="label-bold"/>
               <TextArea fx:id="txtDescripcion" promptText="Describe el objetivo del entrenamiento..." prefRowCount="3" wrapText="true">
                  <tooltip><Tooltip text="Descripción del entrenamiento (opcional)" /></tooltip>
               </TextArea>
            </VBox>

            <Label fx:id="lblValidacion" text="" style="-fx-text-fill: #f43f5e; -fx-font-weight: 600;" managed="false" visible="false"/>

            <HBox VBox.vgrow="ALWAYS" spacing="10.0">
               <children>
                  <VBox HBox.hgrow="ALWAYS" spacing="8.0">
                     <children>
                        <Label text="Ejercicios Disponibles:" styleClass="sub-header"/>
                        <TableView fx:id="tablaEjerNuevoEntreno" VBox.vgrow="ALWAYS">
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                           <columns>
                              <TableColumn fx:id="colNombreEjer" prefWidth="130.0" text="Nombre" />
                              <TableColumn fx:id="colTipo" prefWidth="100.0" text="Tipo" />
                              <TableColumn fx:id="colFinalidad" prefWidth="100.0" text="Finalidad" />
                           </columns>
                        </TableView>
                        <Button mnemonicParsing="false" onAction="#AgregarEjercicio" text="Agregar &gt;" maxWidth="Infinity">
                           <tooltip><Tooltip text="Mover los ejercicios seleccionados al entrenamiento" /></tooltip>
                        </Button>
                     </children>
                  </VBox>

                  <VBox HBox.hgrow="ALWAYS" spacing="8.0">
                     <children>
                        <Label text="Ejercicios del Entreno:" styleClass="sub-header"/>
                        <TableView fx:id="tablaEjerDelEntreno" VBox.vgrow="ALWAYS">
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                           <columns>
                              <TableColumn fx:id="colNombreEjerEntreno" prefWidth="130.0" text="Nombre" />
                              <TableColumn fx:id="colTipoEntreno" prefWidth="100.0" text="Tipo" />
                              <TableColumn fx:id="colFinalidadEntreno" prefWidth="100.0" text="Finalidad" />
                           </columns>
                        </TableView>
                        <Button mnemonicParsing="false" onAction="#QuitarEjercicio" text="&lt; Quitar" maxWidth="Infinity" styleClass="button-secondary">
                           <tooltip><Tooltip text="Quitar los ejercicios seleccionados del entrenamiento" /></tooltip>
                        </Button>
                     </children>
                  </VBox>
               </children>
            </HBox>
            <Button fx:id="btnGuardarEntreno" mnemonicParsing="false" onAction="#GuardarEntreno" text="Guardar Entreno" maxWidth="Infinity">
               <tooltip><Tooltip text="Guardar el entrenamiento con todos los ejercicios añadidos" /></tooltip>
            </Button>
         </children>
      </VBox>
   </content>
</ScrollPane>
