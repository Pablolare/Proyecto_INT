<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox stylesheets="@../styles.css" spacing="15.0" style="-fx-padding: 20;" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javafx.ProyectoINT.Entrenos.ControlEntrenos">
   <children>
       <!-- Top Bar with Back and Header -->
       <HBox alignment="CENTER_LEFT" spacing="10.0">
          <Button styleClass="button-secondary" mnemonicParsing="false" onAction="#PagAtras" text="&lt;" />
          <Label styleClass="header-label" text="Entrenos" />
          <Region HBox.hgrow="ALWAYS" />
          <Button styleClass="button-danger" mnemonicParsing="false" onAction="#Borrar" text="Borrar" />
          <Button mnemonicParsing="false" onAction="#Editar" text="Editar" />
       </HBox>

      <TableView fx:id="tablaEntrenamientos" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colIdEntreno" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="colNombreEntreno" prefWidth="150.0" text="Nombre Entreno" />
            <TableColumn fx:id="colRepeticiones" prefWidth="100.0" text="Repet." />
            <TableColumn fx:id="colFallos" prefWidth="75.0" text="Fallos" />
            <TableColumn fx:id="colAciertos" prefWidth="75.0" text="Aciertos" />
            <TableColumn fx:id="colCompletado" prefWidth="150.0" text="Completado" />
         </columns>
      </TableView>
      
      <HBox alignment="CENTER_RIGHT">
          <Button mnemonicParsing="false" onAction="#ListarEjercicios" text="Listar Ejercicios" />
      </HBox>
   </children>
</VBox>
