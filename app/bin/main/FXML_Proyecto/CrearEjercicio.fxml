<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true" stylesheets="@../styles.css" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javafx.ProyectoINT.CrearEjercicio.ControlCrearEjercicio">
   <content>
      <VBox spacing="15.0" style="-fx-padding: 25;" minHeight="400.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                   <Button styleClass="button-secondary" mnemonicParsing="false" onAction="#Cerrar" text="&lt;">
                      <tooltip><Tooltip text="Volver a la pagina de entrenos" /></tooltip>
                   </Button>
                   <Label styleClass="header-label" text="Crear Ejercicio" />
               </children>
            </HBox>

            <HBox spacing="20.0" VBox.vgrow="ALWAYS">
               <children>
                  <!-- Formulario de creacion -->
                  <VBox alignment="TOP_CENTER" spacing="15.0" prefWidth="300.0">
                     <children>
                        <VBox spacing="8.0" prefWidth="280.0">
                            <Label styleClass="label-bold" text="Nombre del Ejercicio:" />
                            <TextField fx:id="txtNombreEjercicio">
                               <tooltip><Tooltip text="Nombre identificativo del ejercicio" /></tooltip>
                            </TextField>
                        </VBox>

                        <VBox spacing="8.0" prefWidth="280.0">
                            <Label styleClass="label-bold" text="Finalidad:" />
                            <TextField fx:id="txtFinalidad">
                               <tooltip><Tooltip text="Objetivo o finalidad del ejercicio" /></tooltip>
                            </TextField>
                        </VBox>

                        <VBox spacing="8.0" prefWidth="280.0">
                            <Label styleClass="label-bold" text="Tipo:" />
                            <TextField fx:id="txtTipo">
                               <tooltip><Tooltip text="Tipo de ejercicio (ataque, defensa, saque, etc.)" /></tooltip>
                            </TextField>
                        </VBox>

                        <VBox spacing="8.0" prefWidth="280.0">
                           <Label styleClass="label-bold" text="Categorías (opcional):" />
                           <ListView fx:id="listaCategorias" prefHeight="100.0">
                              <tooltip><Tooltip text="Selecciona una o varias categorías (Ctrl+clic para múltiple)" /></tooltip>
                           </ListView>
                        </VBox>

                        <HBox spacing="10.0" alignment="CENTER">
                           <Button fx:id="btnCrear" mnemonicParsing="false" onAction="#Creacion" text="Crear" minWidth="120.0" style="-fx-padding: 12 28;">
                              <tooltip><Tooltip text="Crear el nuevo ejercicio y actualizar la tabla" /></tooltip>
                           </Button>
                           <Button styleClass="button-secondary" mnemonicParsing="false" onAction="#Cerrar" text="Cerrar" minWidth="120.0" style="-fx-padding: 12 28;">
                              <tooltip><Tooltip text="Cerrar y volver a entrenos" /></tooltip>
                           </Button>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- Tabla de ejercicios -->
                  <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="label-bold" text="Ejercicios Existentes:" />
                        <TableView fx:id="tablaEjercicios" VBox.vgrow="ALWAYS">
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                           <columns>
                              <TableColumn fx:id="colNombre" prefWidth="150.0" text="Nombre" />
                              <TableColumn fx:id="colTipo" prefWidth="120.0" text="Tipo" />
                              <TableColumn fx:id="colFinalidad" prefWidth="200.0" text="Finalidad" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </content>
</ScrollPane>
