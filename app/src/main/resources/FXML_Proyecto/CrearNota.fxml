<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true" stylesheets="@../styles.css" prefHeight="600.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javafx.ProyectoINT.Notas.ControlCrearNota">
   <content>
      <VBox spacing="20.0" style="-fx-padding: 30;">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <Button styleClass="button-secondary" mnemonicParsing="false" onAction="#Cancelar" text="&lt;">
                  <tooltip><Tooltip text="Volver a notas" /></tooltip>
               </Button>
               <Label fx:id="lblTituloPantalla" styleClass="header-label" text="Nueva Nota" />
            </HBox>

            <VBox spacing="8.0">
               <Label styleClass="label-bold" text="Título:" />
               <TextField fx:id="txTitulo" promptText="Escribe el título de la nota">
                  <tooltip><Tooltip text="Título de la nota" /></tooltip>
               </TextField>
            </VBox>

            <VBox spacing="8.0" VBox.vgrow="ALWAYS">
               <Label styleClass="label-bold" text="Contenido:" />
               <TextArea fx:id="txContenido" promptText="Escribe el contenido de la nota..." prefHeight="250.0" wrapText="true">
                  <tooltip><Tooltip text="Contenido completo de la nota" /></tooltip>
               </TextArea>
            </VBox>

            <VBox spacing="8.0">
               <Label styleClass="label-bold" text="Entrenamiento asociado (opcional):" />
               <ComboBox fx:id="cmbEntreno" maxWidth="Infinity">
                  <tooltip><Tooltip text="Entrenamiento al que pertenece esta nota" /></tooltip>
               </ComboBox>
            </VBox>

            <HBox spacing="15.0" alignment="CENTER_RIGHT">
               <Button styleClass="button-secondary" mnemonicParsing="false" onAction="#Cancelar" text="Cancelar" style="-fx-padding: 10 25;" />
               <Button mnemonicParsing="false" onAction="#Guardar" text="Guardar" style="-fx-padding: 10 25;">
                  <tooltip><Tooltip text="Guardar la nota" /></tooltip>
               </Button>
            </HBox>
         </children>
      </VBox>
   </content>
</ScrollPane>
