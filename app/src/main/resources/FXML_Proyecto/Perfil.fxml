<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" style="-fx-background: #0f172a; -fx-background-color: #0f172a;" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javafx.ProyectoINT.Perfil.ControlPerfil">
   <content>
      <VBox spacing="15.0" style="-fx-padding: 20; -fx-background-color: #0f172a;" stylesheets="@../styles.css" VBox.vgrow="ALWAYS">
         <children>
            <Button mnemonicParsing="false" onAction="#VolverPaginaPrincipal" prefHeight="12.0" prefWidth="14.0" text="&lt;" />
            <Label styleClass="header-label" text="Perfil" />
            
            <VBox spacing="10.0">
               <children>
                  <HBox prefHeight="70.0" spacing="20.0" VBox.vgrow="NEVER">
                     <children>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="label-bold" text="Nombre:" />
                              <TextField fx:id="txtNombre" />
                              <Label styleClass="label-bold" text="Apellidos:" />
                              <TextField fx:id="txtApellido" />
                           </children>
                        </VBox>
                        <VBox alignment="TOP_CENTER" prefWidth="150.0" spacing="10.0">
                           <children>
                              <ImageView fitHeight="104.0" fitWidth="114.0" pickOnBounds="true" preserveRatio="true" />
                              <Button mnemonicParsing="false" styleClass="button-secondary" text="Cambiar Foto" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  
                  <HBox spacing="10.0">
                       <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                          <Label styleClass="label-bold" text="Correo:" />
                          <TextField fx:id="txtCorreo" />
                          <Label styleClass="label-bold" text="Rol:" />
                          <TextField fx:id="txtRol" />
                       </VBox>
                  </HBox>
                  
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                      <Button mnemonicParsing="false" onAction="#Aceptar" text="Guardar Cambios" />
                      <Button mnemonicParsing="false" onAction="#CerrarSesion" styleClass="button-secondary" text="Cerrar sesión" />
                      <Button mnemonicParsing="false" onAction="#BorrarCuenta" styleClass="button-danger" text="Borrar cuenta" />
                  </HBox>
               </children>
            </VBox>
            
            <Label styleClass="sub-header" text="Usuarios del Sistema" />
            <TableView fx:id="tablaPerfil" VBox.vgrow="ALWAYS">
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               <columns>
                  <TableColumn fx:id="colId_usuario" text="ID" />
                  <TableColumn fx:id="colNombre" text="Nombre" />
                  <TableColumn fx:id="colApellido" text="Apellido" />
                  <TableColumn fx:id="colLogin" text="Login" />
                  <TableColumn fx:id="colContraseña" text="Contraseña" />
                  <TableColumn fx:id="colRol" text="Rol" />
                  <TableColumn fx:id="colCorreo" text="Correo" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </content>
</ScrollPane>
