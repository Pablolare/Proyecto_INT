<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true" stylesheets="@../styles.css" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javafx.ProyectoINT.Notas.ControlNotas">
   <content>
      <VBox spacing="15.0" style="-fx-padding: 25;">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <Button styleClass="button-secondary" mnemonicParsing="false" onAction="#PagAtras" text="&lt;">
                  <tooltip><Tooltip text="Volver a entrenos" /></tooltip>
               </Button>
               <Label styleClass="header-label" text="Notas" />
               <Region HBox.hgrow="ALWAYS" />
               <Button mnemonicParsing="false" onAction="#NuevaNota" text="Nueva Nota" style="-fx-padding: 8 20;">
                  <tooltip><Tooltip text="Crear una nueva nota" /></tooltip>
               </Button>
               <Button styleClass="button-secondary" mnemonicParsing="false" onAction="#Editar" text="Editar">
                  <tooltip><Tooltip text="Editar la nota seleccionada" /></tooltip>
               </Button>
               <Button styleClass="button-danger" mnemonicParsing="false" onAction="#Borrar" text="Borrar">
                  <tooltip><Tooltip text="Borrar la nota seleccionada" /></tooltip>
               </Button>
            </HBox>

            <TextField fx:id="txtBuscar" promptText="Buscar nota..." />

            <TableView fx:id="tablaNotas" VBox.vgrow="ALWAYS" minHeight="300.0">
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               <columns>
                  <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                  <TableColumn fx:id="colTitulo" prefWidth="250.0" text="Título" />
                  <TableColumn fx:id="colEntreno" prefWidth="200.0" text="Entrenamiento" />
                  <TableColumn fx:id="colFecha" prefWidth="180.0" text="Fecha" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </content>
</ScrollPane>
