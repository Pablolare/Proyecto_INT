<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" fitToHeight="true" stylesheets="@../styles.css" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javafx.ProyectoINT.Entrenos.ControlEntrenos">
   <content>
      <VBox spacing="15.0" style="-fx-padding: 25;" minHeight="400.0">
         <children>
             <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Button styleClass="button-secondary" mnemonicParsing="false" onAction="#PagAtras" text="&lt;">
                   <tooltip><Tooltip text="Volver a la pagina principal" /></tooltip>
                </Button>
                <Label styleClass="header-label" text="Entrenos" />
                <Region HBox.hgrow="ALWAYS" />
                <Button styleClass="button-danger" mnemonicParsing="false" onAction="#Borrar" text="Borrar">
                   <tooltip><Tooltip text="Borrar el entrenamiento seleccionado y todos sus ejercicios" /></tooltip>
                </Button>
                <Button mnemonicParsing="false" onAction="#Editar" text="Editar">
                   <tooltip><Tooltip text="Editar el entrenamiento seleccionado" /></tooltip>
                </Button>
             </HBox>

            <TextField fx:id="txtBuscar" promptText="Buscar entrenamiento..." />

            <TableView fx:id="tablaEntrenamientos" VBox.vgrow="ALWAYS">
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               <columns>
                  <TableColumn fx:id="colNombreEntreno" prefWidth="180.0" text="Nombre Entreno" />
                  <TableColumn fx:id="colNumEjercicios" prefWidth="80.0" text="Ejercicios" />
                  <TableColumn fx:id="colRepeticiones" prefWidth="100.0" text="Repet." />
                  <TableColumn fx:id="colFallos" prefWidth="75.0" text="Fallos" />
                  <TableColumn fx:id="colAciertos" prefWidth="75.0" text="Aciertos" />
                  <TableColumn fx:id="colCompletado" prefWidth="150.0" text="Completado" />
               </columns>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <Button mnemonicParsing="false" onAction="#PagNotas" text="Notas">
                   <tooltip><Tooltip text="Ver y gestionar notas de entrenamientos" /></tooltip>
                </Button>
                <Button mnemonicParsing="false" onAction="#PagCategorias" text="Categorías">
                   <tooltip><Tooltip text="Gestionar categorías de ejercicios" /></tooltip>
                </Button>
                <Button mnemonicParsing="false" onAction="#CrearEjercicio" text="Crear Ejercicio">
                   <tooltip><Tooltip text="Crear un nuevo ejercicio" /></tooltip>
                </Button>
                <Button mnemonicParsing="false" onAction="#ListarEjercicios" text="Listar Ejercicios">
                   <tooltip><Tooltip text="Ver los ejercicios del entrenamiento seleccionado" /></tooltip>
                </Button>
            </HBox>
         </children>
      </VBox>
   </content>
</ScrollPane>
