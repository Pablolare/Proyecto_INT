<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>

<VBox spacing="0.0" style="-fx-background-color: #0f172a;" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javafx.ProyectoINT.Informes.ControlInformes">
   
   <children>
      <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #1e293b; -fx-padding: 20;">
         <children>
            <Button text="&lt;" onAction="#PagAtras" 
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 24px; -fx-padding: 5 15; -fx-cursor: hand; -fx-border-color: #475569; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;"
                    onMouseEntered="#onMouseEntered" onMouseExited="#onMouseExited" />
            <Label text="Informes" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;" />
         </children>
      </HBox>
      
      <HBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #1e293b; -fx-padding: 0 20 20 20;">
         <children>
            <VBox spacing="15.0" alignment="CENTER" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER" spacing="10.0">
                     <children>
                        <CheckBox fx:id="checkCombo" text="Informe simple" 
                                  style="-fx-text-fill: #cbd5e1; -fx-font-size: 14px;" selected="true"/>
                        <Label text="Filtrar:" style="-fx-text-fill: #cbd5e1; -fx-font-size: 14px;" />
                        <TextField fx:id="mititulo" promptText="Texto para filtrar..." prefWidth="250.0" 
                                   style="-fx-background-color: #334155; -fx-text-fill: white; -fx-prompt-text-fill: #94a3b8; -fx-font-size: 14px; -fx-padding: 8 12; -fx-border-color: #475569; -fx-border-radius: 6; -fx-background-radius: 6;" />
                     </children>
                  </HBox>
                  
                  <HBox alignment="CENTER" spacing="15.0">
                     <children>
                        <Button fx:id="buttonInformeN" text="Informe Usuarios" onAction="#buttonInforme1" 
                                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 25; -fx-cursor: hand; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-weight: bold;"
                                onMouseEntered="#onMouseEnteredButton" onMouseExited="#onMouseExitedButton">
                           <tooltip>
                              <Tooltip text="Generar informe de usuarios" />
                           </tooltip>
                        </Button>
                        
                        <Button fx:id="buttonInformeG" text="Informe Gráficas" onAction="#buttonInforme2" 
                                style="-fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 25; -fx-cursor: hand; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-weight: bold;"
                                onMouseEntered="#onMouseEnteredButton" onMouseExited="#onMouseExitedButton">
                           <tooltip>
                              <Tooltip text="Generar informe con gráficas" />
                           </tooltip>
                        </Button>
                        
                        <Button fx:id="buttonInformeE" text="Informe Entrenamientos" onAction="#buttonInforme3" 
                                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 25; -fx-cursor: hand; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-weight: bold;"
                                onMouseEntered="#onMouseEnteredButton" onMouseExited="#onMouseExitedButton">
                           <tooltip>
                              <Tooltip text="Generar informe de entrenamientos" />
                           </tooltip>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>
      
      <StackPane VBox.vgrow="ALWAYS" style="-fx-background-color: #0f172a; -fx-padding: 20;">
         <children>
            <WebView fx:id="wv" style="-fx-border-color: #475569; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-radius: 8;" />
         </children>
      </StackPane>
   </children>
</VBox>